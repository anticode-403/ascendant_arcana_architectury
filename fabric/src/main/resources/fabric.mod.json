{
  "schemaVersion": 1,
  "id": "ascendant_arcana",
  "version": "${version}",
  "name": "Ascendant Arcana",
  "description": "A mod that overhauls enchanting and some other forms of Minecraft magic.",
  "authors": [
    "anticode"
  ],
  "contact": {
    "email": "rileyanticode@gmail.com",
    "homepage": "https://modrinth.com/mod/ascendant-arcana",
    "sources": "https://github.com/anticode-403/ascendant_arcana",
    "discord": "https://discord.gg/4cDFfDqfDy",
    "issues": "https://github.com/anticode-403/ascendant_arcana/issues"
  },
  "license": "LGPL-3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "me.anticode.ascendant_arcana.fabric.client.AscendantArcanaFabricDatagen"
    ],
    "main": [
      "me.anticode.ascendant_arcana.fabric.AscendantArcanaFabric"
    ],
    "client": [
      "me.anticode.ascendant_arcana.fabric.client.AscendantArcanaFabricClient"
    ],
    "emi": [
      "me.anticode.ascendant_arcana.client.emi.AscendantArcanaEmi"
    ]
  },
  "mixins": [
    "ascendant_arcana.mixins.json",
    "ascendant_arcana.fabric.mixins.json",
    {
      "config": "ascendant_arcana.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*",
    "cloth-config": ">=11.1.136"
  },
  "suggests": {
    "emi": "*"
  }
}
